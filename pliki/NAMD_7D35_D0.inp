structure	PROT_ctr.psf
coordinates	PROT_ctr.pdb

paratypecharmm	on
parameters	par_all27_prot_na.inp
exclude		scaled1-4
1-4scaling	1.0

switching	on
switchdist	8
cutoff		12
pairlistdist	14
margin		3
stepspercycle	20

wrapWater	on
wrapAll         on
rigidBonds	water

timestep 1.0

outputenergies	1000
outputtiming	1000
binaryoutput	yes
outputname	NAMD_7D35_D0	
dcdfreq         1000

temperature	300

langevin            on
langevinDamping     5
langevinTemp        300
langevinHydrogen    no

useFlexibleCell		yes
useGroupPressure	yes

LangevinPiston		on
LangevinPistonTarget	1.01325
LangevinPistonPeriod	200
LangevinPistonDecay	100
LangevinPistonTemp	300

cellBasisVector1 	53.71099853515625   0.0     0.0
cellBasisVector2         0.0     46.077999114990234   0.0
cellBasisVector3         0.0     0.0     48.555999755859375
cellOrigin               0.0     0.0     0.0

PME yes
PMEGridSpacing 1.0

fixedAtoms	on
fixedAtomsFile  PROT_ctr_FIX.pdb
fixedAtomsCol	O

minimize 1000
run 100000